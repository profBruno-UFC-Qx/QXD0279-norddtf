# Copy this file to `.env` and fill in the empty values.
# Without Infisical, `docker compose` reads the `.env` at the repository root, while the
# scripts that run on the host (`pnpm dev`, `pnpm seed`) read
# `backend/.env`, so copy it to both places.

# Connection string used by the host scripts.
# Inside Compose the API connects to `db:5432`, built from the POSTGRES_* values below.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Separate database used by the tests. The name must end with _test.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/mydb_test"

# Used by Compose to create the database. Must match DATABASE_URL.
# Compose builds the API connection string from these values, so avoid characters
# reserved in URLs (@ : / # ?). A safe password: openssl rand -hex 16
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="mydb"

# Host port where the database is published. Change it if PostgreSQL is already
# installed on your machine, and update DATABASE_URL and TEST_DATABASE_URL to match.
DB_PORTA="5432"

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3333/auth/google/callback"

# Secret used to sign the session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Base URL of the frontend app, used to redirect after the OAuth callback.
FRONTEND_URL="http://localhost:5173"

# Initial accounts created by the seed, which the `setup` service runs on every `docker compose up`.
# The same credentials are listed in ENTREGA.md.
SEED_ADMIN_EMAIL="admin@nordtf.com"
SEED_ADMIN_SENHA="admin1234"
SEED_CLIENTE_EMAIL="cliente@nordtf.com"
SEED_CLIENTE_SENHA="cliente1234"

# Garage (S3 storage for product images). The `setup` service prepares it on every
# `docker compose up`: node layout, access key and the two buckets.
# Inside Compose the API uses `garage:3900`; S3_ENDPOINT is for the host scripts.
# RPC secret of the Garage node. Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=""
# Token of the Garage admin API, used only inside Compose. Generate with: openssl rand -hex 32
GARAGE_ADMIN_TOKEN=""
S3_ENDPOINT="http://localhost:3900"
S3_REGION="garage"
# Access key imported into Garage. Generate the ID with: echo "GK$(openssl rand -hex 12)"
S3_ACCESS_KEY_ID=""
# Generate with: openssl rand -hex 32
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="nordtf"
# Bucket used by the tests. Its objects are deleted at the end of each run.
# The name must end with -test and differ from S3_BUCKET.
S3_BUCKET_TEST="nordtf-test"

# Frontend. The browser calls the API, so this is the address published on the host.
VITE_API_URL="http://localhost:3333"
# WhatsApp number used by the contact links, digits only with country code.
VITE_WHATSAPP_NUMERO="558894389721"
