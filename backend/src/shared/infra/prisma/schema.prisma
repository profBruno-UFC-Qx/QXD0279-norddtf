// use prisma-8

enum TipoPerfil {
  ADMIN
  USER
}

enum StatusPedido {
  RECEBIDO
  CONFIRMADO
  IMPRESSAO
  PRONTO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum TipoProduto {
  PERSONALIZAVEL
  VENDA_DIRETA
}

enum TamanhoRoupa {
  P
  M
  G
  GG
  G1
  G2
}

enum TipoMaterial {
  DTF
  DTF_UV
}

enum TipoItem {
  PRODUTO
  MATERIAL
}

enum PosicaoEstampa {
  FRENTE
  COSTAS
}

model User {
  id        Uuid     @id @default(uuid())
  sub       String?   @unique
  nome      String
  email     String   @unique
  cpf       String?  @unique
  telefone  String?
  senha     String?
  enderecoId Uuid?
  endereco  Endereco? @relation(fields: [enderecoId], references: [id])
  tipoPerfil TipoPerfil @default(USER)
  pedidos   Pedido[]
  criadoEm TimestamptzString @default(now())
  atualizadoEm temporal.updatedAtString()
}

model Endereco {
  id        Uuid     @id @default(uuid())
  userId    Uuid
  user      User     @relation(fields: [userId], references: [id])
  cep       String
  logradouro String
  numero    String
  complemento String?
  bairro    String
  cidade    String
  estado    String
  criadoEm TimestamptzString @default(now())
  atualizadoEm temporal.updatedAtString()
}

model Categoria {
  id        Uuid     @id @default(uuid())
  nome      String
  nomeNormalizado String @unique
  descricao String?
  produtos  ProdutoCategoria[]
  criadoEm TimestamptzString @default(now())
  atualizadoEm temporal.updatedAtString()
}

model ProdutoCategoria {
  produtoId   Uuid
  produto     Produto   @relation(fields: [produtoId], references: [id])
  categoriaId Uuid
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  @@id([produtoId, categoriaId])
  @@index([categoriaId])
}

model Produto {
  id               Uuid     @id @default(uuid())
  nome             String
  descricao        String?
  preco            Numeric(10, 2)
  buscaNormalizada String
  tipo             TipoProduto
  temTamanho       Boolean  @default(true)
  ativo            Boolean  @default(true)
  categorias       ProdutoCategoria[]
  cores            ProdutoCor[]
  criadoEm         TimestamptzString @default(now())
  atualizadoEm     temporal.updatedAtString()

  @@check(expression: "preco >= 0", name: "produto_preco_nao_negativo")
}

model ProdutoCor {
  id                         Uuid     @id @default(uuid())
  produtoId                  Uuid
  produto                    Produto  @relation(fields: [produtoId], references: [id])
  posicao                    Int
  nome                       String
  nomeNormalizado            String
  hex                        String
  imagemApresentacao         String
  imagemApresentacaoCostas   String?
  imagemPersonalizacaoFrente String?
  imagemPersonalizacaoCostas String?
  variantes                  ProdutoVariante[]
  criadoEm                   TimestamptzString @default(now())
  atualizadoEm               temporal.updatedAtString()

  @@unique([produtoId, nomeNormalizado])
}

model ProdutoVariante {
  id           Uuid          @id @default(uuid())
  produtoCorId Uuid
  produtoCor   ProdutoCor    @relation(fields: [produtoCorId], references: [id])
  tamanho      TamanhoRoupa?
  estoque      Int           @default(0)
  itens        Item[]

  @@index(expression: "\"produtoCorId\", coalesce(tamanho, '')", unique: true, name: "produtoVariante_cor_tamanho_key")
  @@check(expression: "estoque >= 0", name: "produtoVariante_estoque_nao_negativo")
}

model Material {
  id             Uuid     @id @default(uuid())
  tipo           TipoMaterial @unique
  precoPorM2     Numeric(10, 2)
  descricao      String
  etiqueta       String
  larguraFolhaCm Decimal  @default("57")
  itens          Item[]
}

model Pedido {
  id        Uuid     @id @default(uuid())
  userId    Uuid
  user      User     @relation(fields: [userId], references: [id])
  status    StatusPedido @default(RECEBIDO)
  valorTotal Decimal
  itens     Item[]
  historicoStatus PedidoStatusHistorico[]
  criadoEm TimestamptzString @default(now())
  atualizadoEm temporal.updatedAtString()
}

model PedidoStatusHistorico {
  id       Uuid     @id @default(uuid())
  pedidoId Uuid
  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  status   StatusPedido
  criadoEm TimestamptzString @default(now())
}

model Item {
  id             Uuid     @id @default(uuid())
  pedidoId       Uuid
  pedido         Pedido   @relation(fields: [pedidoId], references: [id])
  tipo           TipoItem
  produtoVarianteId Uuid?
  produtoVariante   ProdutoVariante? @relation(fields: [produtoVarianteId], references: [id])
  quantidade     Int?
  materialId     Uuid?
  material       Material? @relation(fields: [materialId], references: [id])
  comprimentoCm  Decimal?
  precoUnitario  Decimal
  estampas       ItemEstampa[]
  criadoEm TimestamptzString @default(now())
  atualizadoEm temporal.updatedAtString()
}

model ItemEstampa {
  id             Uuid     @id @default(uuid())
  itemId         Uuid
  item           Item     @relation(fields: [itemId], references: [id])
  arteClienteUrl String?
  posicao        PosicaoEstampa?
  quantidade     Int      @default(1)
  larguraCm      Decimal
  alturaCm       Decimal
}
