# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Separate database used by the tests. The name must end with _test.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/mydb_test"

# Used by docker-compose to create the database. Must match DATABASE_URL.
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="mydb"

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3333/auth/google/callback"

# Secret used to sign the session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Base URL of the frontend app, used to redirect after the OAuth callback.
FRONTEND_URL="http://localhost:5173"

# Initial accounts created by `pnpm seed`. The same credentials are listed in ENTREGA.md.
SEED_ADMIN_EMAIL="admin@nordtf.com"
SEED_ADMIN_SENHA="admin1234"
SEED_CLIENTE_EMAIL="cliente@nordtf.com"
SEED_CLIENTE_SENHA="cliente1234"

# Garage (S3 storage for product images), started with `docker compose up -d garage`
# and prepared with `pnpm garage:iniciar`.
# RPC secret of the Garage node. Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=""
S3_ENDPOINT="http://localhost:3900"
S3_REGION="garage"
# Access key imported into Garage. Generate the ID with: echo "GK$(openssl rand -hex 12)"
S3_ACCESS_KEY_ID=""
# Generate with: openssl rand -hex 32
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="nordtf"
# Bucket used by the tests. Its objects are deleted at the end of each run.
# The name must end with -test and differ from S3_BUCKET.
S3_BUCKET_TEST="nordtf-test"
